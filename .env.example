# GRIDIRON configuration — local-first defaults.
# Copy to .env and edit. Nothing here is required to scaffold the project.

# Storage
GRIDIRON_DATA_DIR=./data
GRIDIRON_DATABASE_URL=sqlite:///./data/gridiron.db

# Queue: inline | redis
GRIDIRON_QUEUE=inline
# GRIDIRON_REDIS_URL=redis://localhost:6379/0

# Analysis model
GRIDIRON_LLM_PROVIDER=rules
# GRIDIRON_LLM_PROVIDER=anthropic
# GRIDIRON_LLM_MODEL=claude-opus-5
# ANTHROPIC_API_KEY=

# Data source (TBD)
# GRIDIRON_DATA_PROVIDER=
