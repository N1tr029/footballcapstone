# Python
__pycache__/
*.py[cod]
.venv/
.pytest_cache/
*.egg-info/

# Node
node_modules/
dist/
*.tsbuildinfo

# Data / artifacts
data/**
!data/.gitkeep

# ...except the clip specs. They are not data: they are the tuned configuration a
# clip took hours to arrive at — the window, the snap, the detector settings and a
# checked homography that the vision model is not asked for twice. Ignoring them
# means the pipeline is reproducible only on the laptop that first ran it.
!data/clips/
!data/clips/specs/
!data/clips/specs/*.json

# ...and the field calibrator, for the same reason: it is the tool a clip gets
# registered with when the vision model cannot do it, not an artifact. The frames
# it loads are data and stay ignored — `calframe <clip>` writes a fresh one.
!data/calibrate.html

# Environment
.env
.env.local

# OS
.DS_Store

# Model weights
*.pt

# Ultralytics' own output directory. It appears when a training run is given a
# relative project path — see labelling.train, which resolves its own — and it is
# training output either way, not source.
runs/

# Coverage
.coverage
htmlcov/
