# Football Capstone configuration — local-first defaults.
# Copy to .env and edit. Nothing here is required to scaffold the project.

# Storage
FOOTBALL_DATA_DIR=./data
FOOTBALL_DATABASE_URL=sqlite:///./data/footballcapstone.db

# Queue: inline | redis
FOOTBALL_QUEUE=inline
# FOOTBALL_REDIS_URL=redis://localhost:6379/0

# Analysis model
FOOTBALL_LLM_PROVIDER=rules
# FOOTBALL_LLM_PROVIDER=anthropic
# FOOTBALL_LLM_MODEL=claude-opus-5
# ANTHROPIC_API_KEY=

# Data source (TBD)
# FOOTBALL_DATA_PROVIDER=
